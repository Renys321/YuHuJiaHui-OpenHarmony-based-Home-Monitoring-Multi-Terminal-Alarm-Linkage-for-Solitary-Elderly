# LOCAL-ALARM-VOICE-CLOSURE 隔离台架参数（仅验收用，禁止作为现场固件）
# 测试参数与正式参数明确区分：缩短时序、启用注入、命令走 UART0（115200 8N1）。
# 台架固件不启动 WiFi/网关/NTP，不产生云端事件。
CONFIG_NODE_ALARM_BENCH_INJECT=y
# 无活动阈值从正式 1800 秒缩短为 20 秒，用于验证触发/恢复/再次触发时序。
CONFIG_NODE_NO_MOTION_SEC=20
# 温湿度确认次数从正式 3/5 缩短为 2/2，用于验证持续确认与回差解除。
CONFIG_NODE_CLIMATE_CONFIRM_COUNT=2
CONFIG_NODE_CLIMATE_CLEAR_COUNT=2
# 限频提醒从正式 300 秒缩短为 10 秒。
CONFIG_NODE_ALARM_REPEAT_SEC=10
CONFIG_NODE_ALARM_BEEP_SEC=5
CONFIG_NODE_NO_MOTION_REQUIRE_ARM=y
