CONFIG_IDF_TARGET="esp32s3"
CONFIG_NODE_ID="esp32-bath"
CONFIG_NODE_ROOM="卫生间"
CONFIG_NODE_GW_PORT=9101
# 卫生间阶段1：PIR + SOS 按键 + AHT20(I2C1) + 板载 XL9555 蜂鸣器；不接 MQ/门磁
# SOS=IO15（双向脚，内部上拉可靠；IO35 仅输入、上拉不可靠，禁用）
# 水漏（继电器干接点，IO37）本轮不做，明天再启用：仅需把 CONFIG_NODE_WATER_GPIO 由 -1 改为 37
CONFIG_NODE_MOTION_GPIO=36
CONFIG_NODE_MOTION_DEBOUNCE_CONFIRM=2
CONFIG_NODE_SOS_GPIO=15
CONFIG_NODE_SOS_DEBOUNCE_CONFIRM=2
CONFIG_NODE_WATER_GPIO=-1
CONFIG_NODE_WATER_ACTIVE_LOW=y
CONFIG_NODE_WATER_CONFIRM_COUNT=3
CONFIG_NODE_WATER_CLEAR_COUNT=3
CONFIG_NODE_DOOR_GPIO=-1
CONFIG_NODE_BUZZER_XL9555=y
CONFIG_NODE_BUZZER_GPIO=-1
CONFIG_NODE_ALARM_BEEP_SEC=10
CONFIG_NODE_BOOT_BEEP_MS=0
CONFIG_NODE_AHT20_ENABLED=y
CONFIG_NODE_I2C_SDA_GPIO=4
CONFIG_NODE_I2C_SCL_GPIO=5
CONFIG_NODE_MQ2_ADC_CHANNEL=-1
CONFIG_NODE_MQ5_ADC_CHANNEL=-1
CONFIG_NODE_MQ2_ALARM_RAW=4096
CONFIG_NODE_MQ5_ALARM_RAW=4096
CONFIG_NODE_MQ_CONFIRM_COUNT=3
CONFIG_NODE_MQ_HYSTERESIS_RAW=20
CONFIG_NODE_TEMP_LOW_C=5
CONFIG_NODE_TEMP_HIGH_C=45
CONFIG_NODE_RH_LOW=10
CONFIG_NODE_RH_HIGH=90
CONFIG_NODE_REPORT_SEC=5
CONFIG_NODE_NO_MOTION_SEC=1800
