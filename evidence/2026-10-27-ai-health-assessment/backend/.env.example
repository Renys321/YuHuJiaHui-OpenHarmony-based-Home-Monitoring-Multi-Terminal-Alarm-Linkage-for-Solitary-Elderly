# Keep the real values in the deployment platform's secret store.
PORT=8080
HOST=127.0.0.1
BACKEND_DATA_FILE=./data/backend-state.json
BACKEND_EVIDENCE_DIR=./data/evidence
# 家庭时区：活动规律报告按这个时区切日/切小时（默认 Asia/Shanghai）。
# 非法 IANA 时区会直接拒绝启动（fail-closed），绝不退化成服务器本地时区。
HOUSEHOLD_TIMEZONE=Asia/Shanghai
# PIR 活动聚合的独立状态文件（默认与 BACKEND_DATA_FILE 同目录下的 activity-state.json）。
BACKEND_ACTIVITY_FILE=./data/activity-state.json
EVIDENCE_MAX_EVENTS=200
EVIDENCE_RETENTION_DAYS=30
API_TOKEN_SECRET=replace-with-at-least-32-random-characters
INGEST_KEY=replace-with-a-different-random-secret-at-least-32-characters
# Default guardian APP login. The password is entered by the user and must never be embedded in the APP.
APP_GUARDIAN_ID=family-guardian
APP_GUARDIAN_PASSWORD=replace-with-at-least-32-random-characters
# Optional WeChat compatibility. Keep all three empty for APP-only deployment,
# or configure all three together later.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ALLOWED_OPENIDS=
# Optional JSON array. Keep real names and phone numbers in the deployment secret store.
CONTACTS_JSON=[]
# WeChat subscribe-message template id (non-secret identifier).
# Leave EMPTY to disable alarm push entirely. A placeholder value (replace/example/xxx/...)
# is rejected at startup so a fake template can never be used.
WECHAT_SUBSCRIBE_TEMPLATE_ID=
# Miniprogram page opened when a notification is tapped.
WECHAT_SUBSCRIBE_PAGE=
# Optional HMAC key (>= 32 chars) used to derive opaque recipient refs from openids.
# Leave empty to derive it from API_TOKEN_SECRET instead. It is never persisted or logged.
RECIPIENT_REF_SECRET=
# Retry tuning for subscribe-message delivery (bounded exponential backoff, per recipient).
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BASE_DELAY_MS=500
NOTIFY_MAX_DELAY_MS=8000
# ---------------- Health profile + DeepSeek health-education advice (2026-10-27) ----------------
# Independent health-profile state file (default: health-state.json next to BACKEND_DATA_FILE).
# It has its own version=1 schema and must be backed up/rolled back separately from the main snapshot.
HEALTH_DATA_FILE=./data/health-state.json
# DeepSeek API key. Keep it ONLY in the deployment platform's secret store: never in source,
# APP, image, logs, responses or the health snapshot. Leave EMPTY to disable the feature
# (the endpoint then returns 503 AI_NOT_CONFIGURED); the backend still starts normally.
DEEPSEEK_API_KEY=
# Must be https; a non-https value makes the backend refuse to start (fail-closed).
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model name, ^[A-Za-z0-9._-]{1,64}$.
DEEPSEEK_MODEL=deepseek-chat
# Per-attempt timeout (1000-15000 ms) and max retries (0-1; only network/timeout/429/5xx).
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_MAX_RETRIES=1
# In-memory advice cache only (never persisted, never stores the raw AI response).
HEALTH_ADVICE_CACHE_TTL_MS=300000
HEALTH_ADVICE_CACHE_MAX=64

