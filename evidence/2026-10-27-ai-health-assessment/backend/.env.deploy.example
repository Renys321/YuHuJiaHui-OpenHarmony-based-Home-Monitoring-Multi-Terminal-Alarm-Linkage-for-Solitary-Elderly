# deploy/.env.deploy.example
#
# 公网主机的运行时变量样例（第一阶段 P0）。**全部是占位符，不含任何真实值。**
#
# 用法：
#   cp deploy/.env.deploy.example deploy/.env.deploy
#   chmod 600 deploy/.env.deploy
#   $EDITOR deploy/.env.deploy          # 只在本地编辑，不要把值贴进聊天/工单/日志
#   docker compose --env-file deploy/.env.deploy -f deploy/compose.public.yaml up -d
#
# ---------------------------------------------------------------------------
# 书写规则（Compose 的 env 文件解析规则与本文件一致，写错会静默变形）
# ---------------------------------------------------------------------------
# 1. 等号两侧不要留空格：NAME=value
# 2. 不要给值加引号。需要 JSON 时直接写 JSON：NAME=["a"]、NAME=[{"k":"v"}]
# 3. 值里不要出现 `$`。Compose 会把 `$` 当变量引用并把 `$xxx` 吃成空串；
#    随机密钥请用不含 `$` 的字母表生成；确实需要字面量 `$` 时写成 `$$`。
# 4. 值里不要出现 `#`（会被当作行内注释起始）。
# 5. 值里不要出现空格；需要空格时改用转义或改结构。
# 6. 本文件只用于公网主机。家庭网关的变量（ONENET_* / BACKEND_* / GATEWAY_*）
#    属于本地主机，**不要**写进本文件，也不要注入到公网容器。
#
# 安全边界：
# - 本文件的真实版本（deploy/.env.deploy）必须保持 0600，且不得进入版本控制、
#   镜像、小程序、日志、报告或聊天窗口。
# - `docker compose config` 会打印解析后的真实值，不要把它输出到日志或 CI。
#
# ---------------------------------------------------------------------------
# 必填变量（7 个）+ 可选微信变量（5 个）
# ---------------------------------------------------------------------------

# 入站站点域名：裸主机名，不带 https://、端口、路径或尾部斜杠。
# 队友 APP 的 API_BASE_URL 将使用 https:// 加这个主机名。
PUBLIC_DOMAIN=eldercare.example.com

# ACME 账户邮箱，用于证书到期通知。必须是真实可收信邮箱。
ACME_EMAIL=REPLACE_WITH_OPERATIONS_MAILBOX@example.invalid

# 会话令牌 HMAC 密钥。后端要求长度 >= 32；请用随机生成，不要复用其他系统的密钥。
API_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 内部摄取密钥（/internal/v1/**，家庭网关用）。必须与 API_TOKEN_SECRET 不同，
# 且必须与家庭网关主机上的 BACKEND_INGEST_KEY 完全一致。
INGEST_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# 监护人 APP 登录账号。可以交给 APP 用户输入，不属于服务端密钥。
APP_GUARDIAN_ID=family-guardian

# 监护人 APP 登录口令，32-256 字符。只能由用户输入，禁止硬编码进 APK。
APP_GUARDIAN_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# APP "联系人 / 一键拨号"数据源：JSON 数组，phone 只保留数字与 + - 空格。
# 该值仅在后端首次建库时作为初始联系人写入持久化快照；
# 之后修改本项不会覆盖已有联系人（快照里已经有联系人时以快照为准）。
# 注意：持久化快照会包含联系人电话与设备上报的坐标（若设备有有效定位），
# 因此快照文件与其备份同属敏感数据，必须限权并加密留存。
CONTACTS_JSON=[{"id":"contact-1","name":"REPLACE_WITH_CONTACT_NAME","relation":"REPLACE_WITH_RELATION","phone":"REPLACE_WITH_PHONE_NUMBER","primary":true}]

# ---------------------------------------------------------------------------
# 可选：以后取得正式微信小程序账号时再填写。当前 APP-only 部署全部留空。
# 三项微信登录配置必须同时为空或同时填写；模板 ID 只有在三项都填写时才能启用。
# ---------------------------------------------------------------------------

# 微信小程序 AppID。属于半公开标识。
WECHAT_APP_ID=

# 微信 AppSecret。只能存在于服务端 Secret，绝不允许进入客户端、镜像或日志。
WECHAT_APP_SECRET=

# 家庭监护人允许名单：JSON 字符串数组，或逗号分隔列表。
# 未知 openid 登录会被拒绝（403），名单移除后旧令牌立即失权，因此本项 fail closed。
# 真实 openid 属个人数据，只能放在这里（0600）或更强的 Secret 管理里。
WECHAT_ALLOWED_OPENIDS=

# 告警订阅消息模板与跳转页。无微信账号时留空。
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_PAGE=
