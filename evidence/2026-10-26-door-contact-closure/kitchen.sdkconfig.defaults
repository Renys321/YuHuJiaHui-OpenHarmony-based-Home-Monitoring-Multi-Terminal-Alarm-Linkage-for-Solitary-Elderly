# Kitchen door firmware config template (SANITIZED, 2026-10-27)
# 真实 Wi-Fi 口令只存在于私有目录 .local/sdkconfig.kitchen.defaults（不进入证据包）。
# 本文件仅记录厨房门磁固件最终生效的非敏感配置项，便于复核与重建。

CONFIG_IDF_TARGET="esp32s3"
CONFIG_NODE_ID="esp32-kitchen"
CONFIG_NODE_ROOM="厨房"
CONFIG_NODE_GW_HOST="10.127.130.179"
CONFIG_NODE_GW_PORT=9101

# 现有外设（未改动）
CONFIG_NODE_MOTION_GPIO=38
CONFIG_NODE_MOTION_DEBOUNCE_CONFIRM=2
CONFIG_NODE_SOS_KEY0_ENABLED=y
CONFIG_NODE_SOS_GPIO=-1
CONFIG_NODE_I2C_SDA_GPIO=4
CONFIG_NODE_I2C_SCL_GPIO=5
CONFIG_NODE_MQ2_ADC_CHANNEL=5
CONFIG_NODE_MQ5_ADC_CHANNEL=6
CONFIG_NODE_LED_GPIO=1
CONFIG_NODE_LED_ACTIVE_LOW=y
CONFIG_NODE_VOICE_ENABLED=y
CONFIG_NODE_VOICE_VOLUME=30
CONFIG_NODE_ALARM_REPEAT_SEC=300
CONFIG_NODE_NO_MOTION_SEC=1800
CONFIG_NODE_NO_MOTION_REQUIRE_ARM=y

# 门磁（2026-10-27 新增）
CONFIG_NODE_DOOR_GPIO=14
CONFIG_NODE_DOOR_OPEN_LEVEL=1
CONFIG_NODE_DOOR_CONFIRM_COUNT=2
CONFIG_NODE_DOOR_CACHE_MAX=8
CONFIG_NODE_DOOR_CACHE_KEEP_SEC=300
# 注意：v7 未发布，固件只上报旧合同 {open,lastOpenTs}；扩展字段仅本地。

# 任务栈
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi（口令已脱敏；真实值只在 .local 私有目录）
CONFIG_NODE_WIFI_SSID="ElderCareLab"
CONFIG_NODE_WIFI_PASS="<REDACTED>"
