# 视频探望中继配置样例（仅变量名/默认值，不含真实密钥）
# 复制为 .env 后用 `node --env-file=.env server.js` 或逐个 export。
# 生产 ECS 由 deploy/video/install-on-ecs.sh 生成 /opt/eldercare/deploy/video.env (600)，不要手抄。

# ---------------------------------------------------------------------------
# 公共
# ---------------------------------------------------------------------------
# 监听地址/端口：默认 0.0.0.0:9443。local 验收建议 127.0.0.1:9443（只给模拟器宿主用）。
VIDEO_RELAY_HOST=0.0.0.0
VIDEO_RELAY_PORT=9443

# local（relay 自己连 DAYU）或 agent（PC agent 出站注册）。留空按配置推断：
#   有 VIDEO_AGENT_KEY -> agent；否则 local。两者不会同时活动。
VIDEO_MODE=

# 手机 APP token 校验用后端（relay 只调 GET /api/v1/overview，只读）。
BACKEND_BASE=http://127.0.0.1:8080

# 单次 ticket 有效期（默认 60000ms=60s，一次性）。
VIDEO_TICKET_TTL_MS=60000

# 并发 viewer 上限（默认 2，超出以 WS 1013 关闭）。
VIDEO_MAX_VIEWERS=2

# 最后一个 viewer 离开后，多长时间内没有新 viewer 就停止取帧（默认 3000ms）。
VIDEO_IDLE_STOP_MS=3000

# DAYU 链路断开后的宽限时间；超过仍未恢复 -> error DAYU_DOWN + WS 1011（默认 30000ms）。
VIDEO_DAYU_DOWN_GRACE_MS=30000

# 重连退避（毫秒，逗号分隔，末值上限）。
VIDEO_RECONNECT_DELAYS_MS=500,1000,2000,5000,10000

# viewer 心跳文本消息间隔；0 关闭。
VIDEO_HEARTBEAT_MS=5000

# /video/session 限流：窗口内每个 token 最多申请次数（超出 429）。
VIDEO_SESSION_RATE_LIMIT=10
VIDEO_SESSION_RATE_WINDOW_MS=60000

# relay 调后端的超时。
VIDEO_BACKEND_TIMEOUT_MS=5000

# 访问日志（不含 query / token / ticket 明文）与日志级别。
VIDEO_ACCESS_LOG=1
VIDEO_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# local 模式
# ---------------------------------------------------------------------------
# DAYU200 VideoStreamServer 地址。PC 上先执行：
#   hdc -t 450100445634303332012847942eca00 fport tcp:9301 tcp:9301
DAYU_HOST=127.0.0.1
DAYU_PORT=9301
DAYU_CONNECT_TIMEOUT_MS=2000
DAYU_HELLO_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# agent 模式（ECS 部署只填这一段 + BACKEND_BASE=http://backend:8080）
# ---------------------------------------------------------------------------
# 取 32 字节以上随机值；只写入 video.env(600)，由 install-on-ecs.sh 生成。
# PC agent 用同一个值：node agent.js --relay wss://<域名>/video/agent --key <KEY>
VIDEO_AGENT_KEY=
