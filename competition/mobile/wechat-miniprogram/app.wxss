page {
  min-height: 100%;
  background: #f4f6f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 8rpx;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.page-title {
  margin: 6rpx 0 6rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-bottom: 24rpx;
  color: #667085;
  font-size: 26rpx;
}

.connection-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 76rpx;
  margin-bottom: 22rpx;
  padding: 16rpx 20rpx;
  border-left: 8rpx solid #b42318;
  background: #fef3f2;
}

.connection-banner.demo {
  border-left-color: #b54708;
  background: #fffaeb;
}

.connection-banner.connected {
  border-left-color: #067647;
  background: #ecfdf3;
}

.connection-banner.partial,
.connection-banner.offline {
  border-left-color: #b54708;
  background: #fffaeb;
}

.connection-banner.unauthorized {
  border-left-color: #b42318;
  background: #fef3f2;
}

.connection-banner > view:first-child {
  min-width: 0;
}

.connection-title {
  font-weight: 700;
}

.connection-detail {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.demo-badge {
  flex: none;
  margin-left: 18rpx;
  padding: 6rpx 10rpx;
  border: 2rpx solid #f79009;
  color: #934f00;
  font-size: 22rpx;
  font-weight: 700;
}

.panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.panel view,
.panel text {
  overflow-wrap: anywhere;
}

.panel-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  border-bottom: 1rpx solid #eaecf0;
}

.row:last-child {
  border-bottom: 0;
}

.muted {
  color: #667085;
}

.status-normal { color: #067647; }
.status-warn { color: #b54708; }
.status-alarm { color: #b42318; }
.status-acked { color: #175cd3; }
.status-offline { color: #667085; }

.state-view {
  padding: 76rpx 28rpx;
  text-align: center;
}

.state-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.state-message {
  color: #667085;
  line-height: 1.65;
}

.primary-button {
  margin-top: 20rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 27rpx;
}

.secondary-button {
  margin-top: 16rpx;
  border: 2rpx solid #d0d5dd;
  background: #ffffff;
  color: #344054;
  font-size: 27rpx;
}

.danger-button {
  margin-top: 18rpx;
  background: #b42318;
  color: #ffffff;
  font-size: 27rpx;
}

.small-button {
  width: auto;
  min-width: 150rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 22rpx;
}
