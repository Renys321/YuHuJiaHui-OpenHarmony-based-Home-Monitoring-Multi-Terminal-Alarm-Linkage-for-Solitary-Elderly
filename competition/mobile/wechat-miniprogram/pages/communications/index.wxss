.compose-note {
  margin-top: 10rpx;
  color: #475467;
  font-size: 23rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.field {
  margin-top: 20rpx;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.field-label {
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
}

.field-error {
  margin-top: 10rpx;
  color: #b42318;
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.picker-value {
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 16rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 6rpx;
  background: #ffffff;
  font-size: 26rpx;
  overflow-wrap: anywhere;
}

.voice-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.voice-option {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 999rpx;
  color: #344054;
  font-size: 24rpx;
}

.voice-option.selected {
  border-color: #0f766e;
  background: #ecfdf5;
  color: #0f766e;
  font-weight: 700;
}

.message-input {
  box-sizing: border-box;
  width: 100%;
  height: 150rpx;
  margin-top: 10rpx;
  padding: 16rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 6rpx;
  background: #ffffff;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.panel-head .panel-title {
  margin-bottom: 0;
}

.message-card {
  margin: 16rpx 0 0;
  padding: 20rpx;
}

.message-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.message-head > view {
  min-width: 0;
}

.message-text {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.message-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.message-ack {
  margin-top: 8rpx;
  color: #175cd3;
  font-size: 23rpx;
}

.message-failure {
  margin-top: 8rpx;
  color: #b42318;
  font-size: 23rpx;
}

.status-queued { color: #b54708; font-size: 24rpx; font-weight: 700; }
.status-delivered { color: #175cd3; font-size: 24rpx; font-weight: 700; }
.status-played { color: #067647; font-size: 24rpx; font-weight: 700; }
.status-acked { color: #067647; font-size: 24rpx; font-weight: 700; }
.status-failed { color: #b42318; font-size: 24rpx; font-weight: 700; }
.status-expired { color: #667085; font-size: 24rpx; font-weight: 700; }
.status-unknown { color: #667085; font-size: 24rpx; font-weight: 700; }
