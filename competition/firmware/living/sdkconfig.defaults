# =====================================================================
# 客厅节点 esp32-living（COM8，Xnv i ESP32-S3 N16R8，16MB Flash / 8MB PSRAM）
# 状态：候选板，尚未部署；DHT11 + PIR + 门磁 + SOS，无 AHT20/MQ/语音/状态灯
# 注意：同键只允许出现一次；本文件按"公共 → 节点差异"顺序排列
# =====================================================================
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---------- 身份与网关 ----------
CONFIG_NODE_ID="esp32-living"
CONFIG_NODE_ROOM="客厅"
CONFIG_NODE_GW_HOST="10.127.130.179"
CONFIG_NODE_GW_PORT=9101

# ---------- Wi-Fi（占位符，真实凭据不入库） ----------
# 构建前用 tools/build-node.ps1 -Ssid/-Pass 写入 firmware/.local/wifi.living.defaults，
# 或手工在该文件填写后由构建脚本以 SDKCONFIG_DEFAULTS 追加。
CONFIG_NODE_WIFI_SSID="YOUR_WIFI"
CONFIG_NODE_WIFI_PASS="YOUR_PASSWORD"

# ---------- 本地外设（接线前必须实测电平） ----------
CONFIG_NODE_DHT11_GPIO=11
CONFIG_NODE_DHT11_BENCH=n
CONFIG_NODE_LOCAL_BENCH=n
CONFIG_NODE_AHT20_ENABLED=n
CONFIG_NODE_MOTION_GPIO=4
CONFIG_NODE_MOTION_DEBOUNCE_CONFIRM=2
CONFIG_NODE_DOOR_GPIO=5
CONFIG_NODE_DOOR_OPEN_LEVEL=1
CONFIG_NODE_DOOR_CONFIRM_COUNT=2
CONFIG_NODE_DOOR_CACHE_MAX=8
CONFIG_NODE_DOOR_CACHE_KEEP_SEC=300
CONFIG_NODE_SOS_GPIO=6
CONFIG_NODE_SOS_DEBOUNCE_CONFIRM=2
CONFIG_NODE_BUZZER_XL9555=n
CONFIG_NODE_BUZZER_GPIO=-1
CONFIG_NODE_VOICE_ENABLED=n

# ---------- 无气体传感器（阈值 4096 = 关闭） ----------
CONFIG_NODE_MQ2_ADC_CHANNEL=-1
CONFIG_NODE_MQ5_ADC_CHANNEL=-1
CONFIG_NODE_MQ2_ALARM_RAW=4096
CONFIG_NODE_MQ5_ALARM_RAW=4096

# ---------- 上报与判定（三节点一致） ----------
CONFIG_NODE_REPORT_SEC=5
CONFIG_NODE_NO_MOTION_SEC=1800
CONFIG_NODE_ALARM_BEEP_SEC=10
CONFIG_NODE_BOOT_BEEP_MS=0
CONFIG_NODE_CLIMATE_CONFIRM_COUNT=3
CONFIG_NODE_CLIMATE_CLEAR_COUNT=5
CONFIG_NODE_TEMP_HYST_C=1
CONFIG_NODE_RH_HYST=3
CONFIG_NODE_ALARM_REPEAT_SEC=300
CONFIG_NODE_NO_MOTION_REQUIRE_ARM=y
CONFIG_NODE_ALARM_CHIRP_ON_MS=200
CONFIG_NODE_ALARM_CHIRP_GAP_MS=100
CONFIG_NODE_ALARM_CHIRP_COUNT=2
CONFIG_NODE_ALARM_CHIRP_COUNT_SOS=3
CONFIG_NODE_ALARM_VOICE_GAP_MS=150
CONFIG_NODE_VOICE_AMP_SETTLE_MS=60
CONFIG_NODE_MQ_CONFIRM_COUNT=3
CONFIG_NODE_MQ_HYSTERESIS_RAW=20
CONFIG_NODE_WATER_GPIO=-1
CONFIG_NODE_WATER_ACTIVE_LOW=y
CONFIG_NODE_WATER_CONFIRM_COUNT=3
CONFIG_NODE_WATER_CLEAR_COUNT=3
CONFIG_NODE_BATTERY_ADC_CHANNEL=-1
CONFIG_NODE_BATTERY_DIVIDER_NUM=2
CONFIG_NODE_BATTERY_DIVIDER_DEN=1
CONFIG_NODE_BATTERY_CAL_GAIN_PERMILLE=1000
CONFIG_NODE_BATTERY_CAL_OFFSET_MV=0
CONFIG_NODE_BATTERY_LOW_MV=3500
CONFIG_NODE_BATTERY_MIN_MV=2500
CONFIG_NODE_BATTERY_MAX_MV=4350
CONFIG_NODE_BATTERY_SAMPLE_SEC=30

# =====================================================================
# 客厅节点差异（放最后，便于阅读；本文件已保证无重复键）
# =====================================================================
# 无语音构建：主任务栈 3584 足够（厨房/卫生间有语音用 8192）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584
# 该候选板无板载状态 LED（IO1 用途未确认）
CONFIG_NODE_LED_GPIO=-1
# 客厅当前用 DHT11，体感阈值放宽（待实测后校准）
CONFIG_NODE_TEMP_LOW_C=10
CONFIG_NODE_TEMP_HIGH_C=40
CONFIG_NODE_RH_LOW=20
CONFIG_NODE_RH_HIGH=85
