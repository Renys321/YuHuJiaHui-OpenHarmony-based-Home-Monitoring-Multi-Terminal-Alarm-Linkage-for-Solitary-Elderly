# deploy/video/video.env.example
#
# 仅供文档参考：真实文件由 install-on-ecs.sh 生成到 /opt/eldercare/deploy/video.env (600)。
# 不要手工复制到仓库或提交；VIDEO_AGENT_KEY 由脚本生成或从 --agent-key 注入。
#
# ECS 上 relay 运行 agent 模式：PC agent 出站 WSS 注册，relay 再把帧分发给手机。
# 没有 DAYU_HOST/DAYU_PORT（ECS 不直连板端，板端只在 USB/HDC 后面）。

VIDEO_MODE=agent
VIDEO_RELAY_HOST=0.0.0.0
VIDEO_RELAY_PORT=9443
BACKEND_BASE=http://backend:8080
VIDEO_AGENT_KEY=<install-on-ecs.sh 生成，48 hex>

VIDEO_MAX_VIEWERS=2
VIDEO_IDLE_STOP_MS=3000
VIDEO_TICKET_TTL_MS=60000
VIDEO_DAYU_DOWN_GRACE_MS=30000
VIDEO_HEARTBEAT_MS=5000
VIDEO_RECONNECT_DELAYS_MS=500,1000,2000,5000,10000
VIDEO_SESSION_RATE_LIMIT=10
VIDEO_SESSION_RATE_WINDOW_MS=60000
VIDEO_BACKEND_TIMEOUT_MS=5000
VIDEO_ACCESS_LOG=1
VIDEO_LOG_LEVEL=info
