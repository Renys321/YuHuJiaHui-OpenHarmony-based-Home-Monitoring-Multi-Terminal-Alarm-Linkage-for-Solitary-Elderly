# COM8 客厅节点 bench 配置（DHT11/PIR/SOS，门磁未接而禁用）
# 板卡：Xnv i ESP32-S3 N16R8 Type-C（CH343），16MB Flash / 8MB PSRAM
# 仅本地构建；无 Wi-Fi 凭据；本轮不烧录
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# DHT11：3.3V，DATA GPIO11，4.7k~10k 上拉
CONFIG_NODE_AHT20_ENABLED=n
CONFIG_NODE_DHT11_GPIO=11
CONFIG_NODE_DHT11_BENCH=y
CONFIG_NODE_LOCAL_BENCH=y

# 门磁未接：禁用 GPIO5，避免把悬空/默认电平当门状态
CONFIG_NODE_DOOR_GPIO=-1

# PIR SR312：GPIO4，高电平有效；OUT 电平需实测 <=3.3V
CONFIG_NODE_MOTION_GPIO=4
CONFIG_NODE_MOTION_DEBOUNCE_CONFIRM=2

# SOS：GPIO6 对 GND，瞬动按键，内部上拉，按下为低
CONFIG_NODE_SOS_GPIO=6
CONFIG_NODE_SOS_DEBOUNCE_CONFIRM=2

CONFIG_NODE_WATER_GPIO=-1
CONFIG_NODE_BUZZER_XL9555=n
CONFIG_NODE_BUZZER_GPIO=-1
CONFIG_NODE_MQ2_ADC_CHANNEL=-1
CONFIG_NODE_MQ5_ADC_CHANNEL=-1

# 身份/网关；Wi-Fi 凭据不写入源码
CONFIG_NODE_ID="esp32-living"
CONFIG_NODE_ROOM="客厅"
CONFIG_NODE_GW_HOST="10.1.189.200"
CONFIG_NODE_GW_PORT=9101
CONFIG_NODE_REPORT_SEC=5
CONFIG_NODE_NO_MOTION_SEC=1800
